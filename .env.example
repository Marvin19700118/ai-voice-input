# 複製此檔為 .env 並填入你的設定

# Claude API 金鑰（用於 AI 潤飾，可留空則跳過潤飾）
ANTHROPIC_API_KEY=sk-ant-...

# Whisper 模型大小：tiny / base / small / medium / large-v3
# tiny/base 速度快但準確度較低，medium/large 準確度高但較慢
WHISPER_MODEL=base

# 運算裝置：auto / cpu / cuda（有 NVIDIA GPU 請用 cuda）
WHISPER_DEVICE=auto

# 語言：留空=自動偵測，或指定 zh / en / ja 等
WHISPER_LANGUAGE=

# 是否啟用 AI 潤飾（需要 ANTHROPIC_API_KEY）
USE_POLISH=true

# 觸發熱鍵（按住錄音，放開送出）
HOTKEY=f4
